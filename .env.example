# ============================================================================
# MULTILEVEL PLUS — muhit o'zgaruvchilari
#
# 1. Bu faylning NUSXASINI oling va nomini `.env.local` qiling
# 2. Qiymatlarni Supabase loyihangizdan ko'chiring (SETUP.md, 3-qadam)
#
# ⚠️ `.env.local` faylini HECH QACHON GitHub'ga yuklamang —
#    u allaqachon .gitignore ichida.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Loyihangiz manzili. Masalan: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" kaliti — brauzerga chiqadi, bu normal holat.
# (Yangi Supabase loyihalarida u "publishable key" deb ataladi.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" kaliti — FAQAT SERVERDA ishlatiladi.
# ⚠️ Bu kalit RLS himoyasini chetlab o'tadi. Uni hech kimga bermang,
#    brauzer kodiga yozmang va GitHub'ga yuklamang.
# Bu kalit quyidagilar uchun kerak:
#   • foydalanuvchiga Premium berish
#   • rollarni (admin / o'qituvchi) o'zgartirish
#   • admin panelda savollarning to'g'ri javoblarini ko'rish
#   • Speaking audiolarini o'qituvchiga eshittirish
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Sayt manzili
# ---------------------------------------------------------------------------

# Lokal ishlaganda shunday qoldiring.
#
# Railway'da bu o'zgaruvchini QO'SHMASANGIZ ham bo'ladi — Railway bergan
# domen avtomatik aniqlanadi. Faqat o'z domeningizni ulasangiz yozing:
#   https://multilevelplus.uz
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email + kod orqali kirish (ixtiyoriy)
# ---------------------------------------------------------------------------

# Sukut bo'yicha kirish sahifasida faqat Google tugmasi ko'rinadi.
# O'z pochta xizmatingizni (SMTP) ulaganingizdan keyin "on" qiling —
# SETUP.md, 6-qadam.
# EMAIL_LOGIN=on

# ---------------------------------------------------------------------------
# Onlayn to'lov — Payme va Click (Uzcard, Humo). Ixtiyoriy.
# Kalit kiritilmagan tizim saytda ko'rinmaydi. SETUP.md → "Onlayn to'lov".
# ---------------------------------------------------------------------------

# Payme Business kabineti → Kassa → "ID kassy" va "Ключ"
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# Sinov paytida "on" (test kaliti bilan). Haqiqiy to'lovlarda o'chiring.
# PAYME_TEST_MODE=on

# Click Merchant kabineti → Service
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# CLICK_MERCHANT_USER_ID=

# Payme fiskal cheki (ixtiyoriy, Payme talab qilsa): MXIK kodi (tasnif.soliq.uz),
# o'lchov birligi kodi va QQS foizi (QQS to'lovchi bo'lmasa 0)
# PAYME_IKPU_CODE=
# PAYME_PACKAGE_CODE=
# PAYME_VAT_PERCENT=0
